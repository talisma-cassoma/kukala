// Prisma schema for the storefront catalog and order data
// This is designed to mirror the content shape exposed by the Crystallize-style queries.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    directUrl = env("DATABASE_DIRECT_URL")
}

model Page {
    id          String   @id @default(cuid())
    slug        String   @unique
    title       String?
    description String?
    path        String   @unique
    type        String   @default("page")
    published   Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    heroImage       String?
    heroText        String?
    metaTitle       String?
    metaDescription String?

    gridItems GridItem[]
    products  Product[]
    sections  Section[]
}

model Section {
    id        String   @id @default(cuid())
    pageId    String
    page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
    title     String?
    kind      String   @default("content")
    body      Json?
    order     Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model GridItem {
    id        String   @id @default(cuid())
    pageId    String
    page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
    name      String
    path      String
    price     Decimal?
    imageUrl  String?
    imageAlt  String?
    topics    Topic[]
    order     Int      @default(0)
    colspan   Int      @default(1)
    rowspan   Int      @default(1)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Product {
    id                String   @id @default(cuid())
    slug              String   @unique
    name              String
    path              String   @unique
    type              String   @default("product")
    published         Boolean  @default(true)
    isBundle          Boolean  @default(false)
    summary           String?
    body              String?
    nutritionJson     Json?
    relatedProductIds String[]
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    pageId String?
    page   Page?   @relation(fields: [pageId], references: [id])

    defaultVariantId String?
    defaultVariant   ProductVariant? @relation("DefaultVariant", fields: [defaultVariantId], references: [id])

    variants ProductVariant[]
    topics   Topic[]
    images   ProductImage[]
    orders   OrderItem[]
}

model ProductVariant {
    id         String   @id @default(cuid())
    productId  String
    product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    sku        String   @unique
    name       String
    price      Decimal
    currency   String   @default("USD")
    stock      Int      @default(0)
    isDefault  Boolean  @default(false)
    attributes Json?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    defaultForProduct Product[]      @relation("DefaultVariant")
    images            ProductImage[]
}

model ProductImage {
    id        String          @id @default(cuid())
    productId String?
    product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
    variantId String?
    variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
    url       String
    altText   String?
    width     Int?
    height    Int?
    key       String?
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt
}

model Topic {
    id        String     @id @default(cuid())
    name      String     @unique
    slug      String     @unique
    products  Product[]
    gridItems GridItem[]
}

model Order {
    id            String      @id @default(cuid())
    status        String      @default("pending")
    customerEmail String?
    totalNet      Decimal
    totalGross    Decimal
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
    items         OrderItem[]
}

model OrderItem {
    id         String   @id @default(cuid())
    orderId    String
    order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    productId  String?
    product    Product? @relation(fields: [productId], references: [id])
    variantId  String?
    name       String
    quantity   Int
    unitPrice  Decimal
    totalPrice Decimal
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}
