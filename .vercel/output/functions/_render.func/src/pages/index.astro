---
import { Grid } from "../components/grid";
import { Products } from "../components/products";
import Layout from "../layouts/Layout.astro";
import { fetchFrontPage } from "../use-cases/queries/frontpage.ts";

//const data = await importJSON();
// console.log(data);
const data = await fetchFrontPage(Astro.url.origin);


const { page, catalog, products } = data;
const { grid } = catalog;
---

<Layout
  title={page?.title ?? "Kulala"}
  description={page?.description ?? "One stop shop for buying cosmetic & personal care online."}>
  <div class="py-10 lg:container mx-auto w-full md:px-0 px-3">
    <Grid grid={grid} />
    <Products donuts={{ children: products }} />
  </div>
</Layout>
