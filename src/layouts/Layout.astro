---
import { Header } from "@/components/header";
import { Background } from "@/components/background";
import "@/styles/global.css";
import kukala_logo from "@/assets/black_logo.png";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { pathname } = Astro.url;
---

<!doctype html>
<html lang="fr" class="w-full min-h-screen m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={kukala_logo.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      import { initializeCart } from "@/pages/shop/cartStore";
      initializeCart();
    </script>
  </head>
  <body
    class="relative min-h-screen w-full bg-primary text-text flex flex-col items-center"
  >
    {
      pathname === "/cart" ||
      pathname === "/checkout" ||
      pathname.startsWith("/order") ? null : (
        <div class="absolute top-[12%] lg:top-50 inset-0 -z-10 pointer-events-none flex flex-col w-full h-full overflow-hidden">
          <div class="h-20 lg:h-40 w-full shrink-0" />

          <div class="w-full shrink-0">
            <Background />
          </div>

          <div class="w-full bg-[#FEE8F0] flex-1" />
        </div>
      )
    }

    <Header client:load />

    <main class="w-full px-4 flex-1 flex flex-col items-center max-w-7xl">
      <slot />
    </main>

    <footer class="container max-w-7xl mt-20 mx-auto pb-10 px-4">
      <div class="flex mt-10 w-full text-center justify-end">
        <div class="flex items-center gap-1 mt-10">
          Powered by <a href="/" class="underline">
            <img src={kukala_logo.src} alt="Kukala" class="w-20" />
          </a>
        </div>
      </div>
    </footer>

    <!-- <style is:global>
      @utility no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;

        &::-webkit-scrollbar {
          display: none;
        }
      }
      @media screen and (max-width: 768px) {
        .crystallize-grid {
          display: flex !important;
          flex-direction: column !important;
        }
        .bg-fixed {
          display: none;
        }
      }
      .bg-fixed {
        background-attachment: fixed;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }
    </style> -->
  </body>
</html>
