---
import "@/styles/global.css";
import kukala_logo from "@/assets/black_logo.png";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dashboard",
  description = "Kukala dashboard",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="w-full min-h-screen m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={kukala_logo.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>