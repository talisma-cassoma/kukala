---
import { Kits } from "@/components/kits/index.tsx";
import { Products } from "@/components/products";
import Layout from "@/layouts/Layout.astro";
import { getFrontPageData } from "@/use-cases/queries/frontpage.ts";

const catalog = await getFrontPageData();
---

<Layout
    title="Kukala Shop"
    description="One stop shop for buying cosmetic & personal care online."
>
	<div class="py-10 lg:container mx-auto w-full md:px-0 px-3">
		<Kits products={catalog} />
		<Products elements={{ children: catalog?.retailProducts ?? [] }} />
	</div>
</Layout>
