---
import { Kits } from "../components/kits/index.tsx";
import type { ProductsType } from "@/use-cases/contracts/Cell";
import { Products } from "../components/products";
import Layout from "../layouts/Layout.astro";
import { fetchFrontPage } from "../use-cases/queries/frontpage.ts";

const catalog = await fetchFrontPage(Astro.url.origin);
console.log("catalog", JSON.stringify(catalog));
---

<Layout
    title="Kulala shop"
    description="One stop shop for buying cosmetic & personal care online."
>
    <div class="py-10 lg:container mx-auto w-full md:px-0 px-3">
        <Kits products={catalog} />
        <Products donuts={{ children: catalog.retailProducts }} />
    </div>
</Layout>
