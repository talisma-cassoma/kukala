---
import { Order } from "@/components/order";
import Layout from "@/layouts/Layout.astro";
import type { OrderProps } from "@/use-cases/contracts/Order";

const { id } = Astro.params;

async function getOrderById(orderId: string, baseUrl: string): Promise<OrderProps['order'] | null> {
    // Construct an absolute URL for server-side fetching
    const url = new URL(`/api/orders/${orderId}`, baseUrl);
    const res = await fetch(url.toString());
    if (!res.ok) {
        console.error(`Failed to fetch order: ${res.status} ${res.statusText}`);
        return null;
    }
    return res.json();
}

const order = await getOrderById(id!, Astro.url.origin);
//console.log("Fetched order:", JSON.stringify(order));
---

<Layout title="Order Confirmation" description="Order confirmation page">
    {order ? <Order order={order} /> : <p>Order not found.</p>}
</Layout>