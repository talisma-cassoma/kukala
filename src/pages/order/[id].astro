---
import { Order } from "@/components/order";
import Layout from "@/layouts/Layout.astro";
import { getOrderById } from "@/use-cases/queries/get-order";

const { id } = Astro.params;
const order = id ? await getOrderById(id, Astro.url.origin) : null;
---

<Layout title="Order Confirmation" description="Order confirmation page">
    <div class="py-12 w-full max-w-4xl mx-auto">
        {order ? (
            <Order order={order} client:load />
        ) : (
            <div class="text-center py-20">
                <h1 class="text-2xl font-bold mb-4">Order not found</h1>
                <p class="text-gray-600 mb-6">We could not find the order details for this ID.</p>
                <a href="/" class="underline font-semibold">Back to store</a>
            </div>
        )}
    </div>
</Layout>
