            },
            "body": {
                "content": {
                    "paragraphs": [
                        {
                            "title": "Our Best-Selling Donut",
                            "body": {
                                "json": [
                                    {
                                        "kind": "block",
                                        "type": "paragraph",
                                        "metadata": {},
                                        "children": [
                                            {
                                                "kind": "inline",
                                                "metadata": {},
                                                "textContent": "What could be better than chocolate? This donut is a chocolate lover's dream! Enjoy fresh or keep some perfectly frozen donuts on hand to satisfy your sweet tooth whenever you want."
                                            }
                                        ]
                                    }
                                ]
                            },
                            "images": []
                        },
                        {
                            "title": "Frozen Donuts - For Best Results",
                            "body": {
                                "json": [
                                    {
                                        "kind": "block",
                                        "type": "paragraph",
                                        "metadata": {},
                                        "children": [
                                            {
                                                "kind": "inline",
                                                "metadata": {},
                                                "textContent": "Store your frozen donuts in their packaging at 0° F / -17° C. Stored properly, they should keep for 2-3 months. To defrost, remove from packaging and transfer to a plate. Let thaw at room temperature for about an hour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            "images": [
                                {
                                    "url": "https://media.crystallize.com/dounot/22/12/2/5/two-chooclate-donuts.jpg",
                                    "altText": "chocolate donuts",
                                    "variants": []
                                }
                            ]
                        },
                        {
                            "title": null,
                            "body": {
                                "json": [
                                    {
                                        "kind": "block",
                                        "type": "paragraph",
                                        "metadata": {},
                                        "children": [
                                            {
                                                "kind": "inline",
                                                "metadata": {},
                                                "textContent": "To reheat the donuts, you can use a microwave (15-20 second bursts) or oven (350° F / 177° C for 5 minutes or until desired temperature is reached)."
                                            }
                                        ]
                                    }
                                ]
                            },
